{
  "name": "rehearsal-space",
  "version": "0.1.0",
  "description": "An all-in-one tool for music practice and song-writing",
  "main": "out/main/index.js",
  "keywords": [],
  "author": "Tim Court",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "ELECTRON_DISABLE_SANDBOX=1 electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "signalsmith-stretch": "^1.3.2",
    "tonal": "^6.4.3",
    "zustand": "^5.0.15"
  }
}
