{
  "name": "rehearsal-space",
  "version": "0.3.4",
  "description": "An all-in-one tool for music practice and song-writing",
  "desktopName": "rehearsal-space.desktop",
  "main": "out/main/index.js",
  "keywords": [],
  "author": {
    "name": "Tim Court",
    "email": "timcourt@duck.com"
  },
  "homepage": "https://github.com/tctimmeh/rehearsal-space-v3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tctimmeh/rehearsal-space-v3.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "ELECTRON_DISABLE_SANDBOX=1 electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tuner": "vitest run --config vitest.replay.config.ts",
    "pack": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "signalsmith-stretch": "^1.3.2",
    "tonal": "^6.4.3",
    "zustand": "^5.0.15"
  }
}
