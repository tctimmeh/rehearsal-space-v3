{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/core/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022"],
    "paths": { "@core/*": ["./src/core/*"], "@shared/*": ["./src/shared/*"] }
  }
}
